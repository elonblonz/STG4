diff --git a/client/src/css/modern.css b/client/src/css/modern.css
new file mode 100644
index 0000000..c51bfae
--- /dev/null
+++ b/client/src/css/modern.css
@@ -0,0 +1,145 @@
+/* A lighter, more modern look on top of the other stylesheets: typography, rounded cards and
+   buttons, softer shadows, focus rings. Loaded last. All colours still come from the tokens in
+   `app.css`, so the light and the dark theme both follow. */
+
+:root {
+  --ff-primary: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+  --radius-sm: 6px;
+  --radius: 10px;
+  --radius-lg: 14px;
+  --shadow-sm: 0 1px 2px var(--clr-shadow-soft);
+  --shadow: 0 2px 10px var(--clr-shadow-soft);
+  --focus-ring: 0 0 0 3px color-mix(in srgb, var(--clr-primary) 45%, transparent);
+}
+
+/* Text in hints, conclusions, intros and docs (rendered Markdown, inside `.markdown` or a
+   `.message`). `reset.css` sets `font: inherit` on everything, so restore what Markdown needs. */
+:is(.markdown, .message) :is(strong, b) {
+  font-weight: 650;
+}
+
+:is(.markdown, .message) h1, :is(.markdown, .message) h2, :is(.markdown, .message) h3, :is(.markdown, .message) h4 {
+  font-weight: 650;
+  line-height: 1.25;
+  margin: .9em 0 .4em;
+}
+:is(.markdown, .message) h1 { font-size: 1.35em; }
+:is(.markdown, .message) h2 { font-size: 1.2em; }
+:is(.markdown, .message) h3 { font-size: 1.08em; }
+:is(.markdown, .message) h4 { font-size: 1em; color: var(--clr-text-secondary); }
+:is(.markdown, .message) > :first-child { margin-top: 0; }
+
+:is(.markdown, .message) p + p, :is(.markdown, .message) p + ul, :is(.markdown, .message) ul + p, :is(.markdown, .message) p + ol, :is(.markdown, .message) ol + p,
+:is(.markdown, .message) blockquote + p, :is(.markdown, .message) p + blockquote {
+  margin-top: .6em;
+}
+
+:is(.markdown, .message) ul, :is(.markdown, .message) ol {
+  padding-left: 1.4em;
+}
+:is(.markdown, .message) li + li {
+  margin-top: .25em;
+}
+
+/* Used for the "written out" proofs in conclusions. */
+:is(.markdown, .message) blockquote {
+  margin: .6em 0;
+  padding: .5em .9em;
+  border-left: 3px solid var(--clr-primary);
+  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
+  background: color-mix(in srgb, var(--clr-surface) 70%, transparent);
+  color: var(--clr-text);
+}
+:is(.markdown, .message) blockquote p + p {
+  margin-top: .5em;
+}
+
+/* Buttons */
+.btn {
+  border-radius: var(--radius-sm);
+  padding: .3rem .8em;
+  font-weight: 500;
+  transition: filter .15s, background-color .15s, color .15s, box-shadow .15s;
+}
+.btn:hover:not([disabled]):not(.btn-disabled) {
+  filter: brightness(1.08);
+}
+.btn-inverted:hover:not([disabled]):not(.btn-disabled) {
+  filter: none;
+  background: var(--clr-surface-subtle);
+}
+.btn:focus-visible, .tab:focus-visible, .inventory .item:focus-visible {
+  outline: none;
+  box-shadow: var(--focus-ring);
+}
+
+/* App bar: a flat bar with a soft shadow instead of a dark glow. */
+.app-bar {
+  filter: none;
+  box-shadow: 0 1px 0 var(--clr-divider), 0 2px 8px var(--clr-shadow-soft);
+}
+
+/* Hints, conclusions and Lean messages as soft cards. */
+.message {
+  border-radius: var(--radius);
+  padding: .7em 1em;
+  line-height: 1.55;
+}
+.chat .message {
+  margin-top: .75em;
+  margin-bottom: .75em;
+}
+
+/* The proof: the statement, the entered commands and the command line. */
+.typewriter-info .proof {
+  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
+  box-shadow: var(--shadow-sm);
+}
+.exercise .command, .exercise .failed-command {
+  border-radius: var(--radius);
+  padding: .4em;
+}
+.exercise .command-text {
+  border-radius: var(--radius-sm);
+}
+.undo-button {
+  border-radius: var(--radius-sm);
+}
+.typewriter {
+  border-radius: var(--radius);
+}
+.typewriter .typewriter-input-wrapper {
+  border-radius: var(--radius-sm);
+}
+
+/* Tabs and inventory */
+.tab {
+  transition: color .15s, border-color .15s;
+}
+.tab:hover {
+  color: var(--clr-text);
+}
+.inventory .item {
+  transition: background-color .15s;
+}
+.inventory .item:hover {
+  background: var(--clr-surface-subtle);
+}
+
+/* Popups */
+.modal {
+  border-radius: var(--radius-lg);
+  box-shadow: 0 10px 40px var(--clr-shadow-soft);
+  overflow: auto;
+}
+
+/* Thin scrollbars where the browser supports them. */
+.typewriter-info, .chat, .inventory, .modal {
+  scrollbar-width: thin;
+}
+
+/* The world images (e.g. the Venn diagrams) are drawn for a white page. In dark mode, invert
+   their lightness but keep their hues, so they don't show as bright white cards. */
+:root[data-theme="dark"] .world-image {
+  filter: invert(.9) hue-rotate(180deg);
+}
